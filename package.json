{
  "name": "@fireblocks/universal-gasless-7702-contract",
  "description": "A smart contract project levearaging EIP-7702 for universal gasless transactions",
  "version": "1.0.0",
  "author": {
    "name": "Fireblocks",
    "url": "https://www.fireblocks.com/platforms/wallets-as-a-service/"
  },
  "dependencies": {
    "@openzeppelin/contracts": "5.2.0"
  },
  "devDependencies": {
    "forge-std": "github:foundry-rs/forge-std#v1.9.6",
    "prettier": "^3.5.0",
    "solhint": "^5.0.5"
  },
  "keywords": [
    "blockchain",
    "ethereum",
    "forge",
    "foundry",
    "smart-contracts",
    "solidity",
    "template"
  ],
  "private": true,
  "scripts": {
    "clean": "rm -rf cache out",
    "build": "forge build",
    "lint": "bun run lint:sol && bun run prettier:check",
    "lint:sol": "forge fmt --check && bun solhint \"{script,src,tests}/**/*.sol\"",
    "prettier:check": "prettier --check \"**/*.{json,md,yml}\" --ignore-path \".prettierignore\"",
    "prettier:write": "prettier --write \"**/*.{json,md,yml}\" --ignore-path \".prettierignore\"",
    "flatten:ugd": "forge flatten src/UniversalGaslessDelegate.sol --output src/flattened/UniversalGaslessDelegate.flat.sol",
    "test": "forge test --no-match-test \"(test_gas|testFork)\"",
    "test:coverage": "EX_PATTERN=$(awk '{ printf \"|%s\", $0 }' lcovreport.exclude) && forge coverage --ir-minimum --no-match-coverage \"(tests|mock|forge-std|script${EX_PATTERN})\" --no-match-test \"(test_gas|testFork)\" --include-libs",
    "test:coverage:all-libs": "forge coverage --ir-minimum --no-match-coverage \"(tests|mock|forge-std|script)\" --no-match-test \"(test_gas|testFork)\" --include-libs",
    "test:coverage:report": "sh coverage-report.sh"
  }
}
